---
import { asset } from '../content/site';
interface Props { poster:string; video?:string; alt:string; eager?:boolean; controls?:boolean; portrait?:boolean; }
const {poster,video,alt,eager=false,controls=false,portrait=false}=Astro.props;
---
<div class:list={["media-frame", {"media-frame--portrait": portrait}]}><img src={asset(poster)} alt={alt} width="1200" height="750" loading={eager?'eager':'lazy'} fetchpriority={eager?'high':'auto'}>{video && <video muted={!controls} controls={controls} playsinline preload="metadata" poster={asset(poster)} aria-label={alt}><source src={asset(video)} type="video/mp4"></video>}{!controls && <span class="play" aria-hidden="true">▶</span>}</div>
