---
import BaseLayout from '../layouts/BaseLayout.astro'; import Header from './Header.astro'; import Footer from './Footer.astro'; import {site} from '../content/site';
interface Props { title:string; intro:string; kind:'offer'|'privacy'|'contacts' }
const {title,intro,kind}=Astro.props;
---
<BaseLayout title={`${title} — NeuroVideo`} description={intro}><Header/><main class="legal container"><p class="eyebrow">NEUROVIDEO / ДОКУМЕНТЫ</p><h1>{title}</h1><p class="legal-lede">{intro}</p>{kind==='contacts'?<section><h2>Контактные данные</h2><p>Исполнитель: {site.business.performer}</p><p>Статус: {site.business.status}</p><p>ИНН: {site.business.inn}</p><p>Email: {site.business.email}</p><p>Telegram: <a href={site.business.telegram}>{site.business.telegram}</a></p><aside>TODO: укажите ИНН и email в <code>src/content/site.ts</code> до публикации.</aside></section>:<section><h2>Текст документа готовится</h2><p>На этой странице будет размещена финальная редакция документа. До начала приёма платежей владелец сайта должен добавить юридически проверенный текст и заполнить реквизиты.</p><aside>TODO: заменить этот блок финальным текстом {kind==='offer'?'публичной оферты':'политики конфиденциальности'}. Юридические условия намеренно не выдуманы.</aside><h2>Реквизиты исполнителя</h2><p>{site.business.performer} · ИНН {site.business.inn} · {site.business.email}</p></section>}</main><Footer/></BaseLayout>
<style>.legal{padding-top:100px;padding-bottom:140px;max-width:960px}.legal h1{white-space:normal}.legal-lede{font-size:21px;color:var(--muted);max-width:760px}.legal section{background:var(--surface);padding:45px;margin-top:55px;border:1px solid var(--border);border-radius:16px}.legal section h2{font-size:28px;margin:35px 0 15px}.legal section h2:first-child{margin-top:0}.legal aside{border-left:3px solid var(--accent);background:var(--soft);padding:20px;margin-top:30px}.legal a{text-decoration:underline}@media(max-width:700px){.legal{padding-top:70px}.legal section{padding:25px}.legal h1{font-size:44px}}</style>
