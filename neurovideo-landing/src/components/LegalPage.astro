---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
interface Props { title: string; description: string; eyebrow?: string }
const { title, description, eyebrow = 'NEUROVIDEO / ДОКУМЕНТЫ' } = Astro.props;
---
<BaseLayout title={`${title} — NeuroVideo`} description={description}>
  <Header />
  <main class="legal container">
    <a class="back-link" href={import.meta.env.BASE_URL}>← Вернуться на главную</a>
    <article>
      <p class="eyebrow">{eyebrow}</p>
      <slot />
    </article>
  </main>
  <Footer />
</BaseLayout>
<style>
  .legal{padding-top:72px;padding-bottom:120px;max-width:960px}
  .back-link{display:inline-block;margin-bottom:48px;font-weight:650;border-bottom:1px solid var(--text)}
  article{background:var(--surface);padding:clamp(28px,6vw,72px);border:1px solid var(--border);border-radius:18px}
  article :global(h1){font-size:clamp(40px,6vw,66px);line-height:1.02;white-space:normal;margin:14px 0 18px}
  article :global(h2){font-size:clamp(24px,3vw,32px);line-height:1.2;margin:52px 0 20px;letter-spacing:-.025em}
  article :global(h3){font-size:20px;line-height:1.35;margin:0 0 28px;color:var(--muted)}
  article :global(p),article :global(li){line-height:1.75}
  article :global(p){margin-bottom:18px}
  article :global(ul){padding-left:24px;margin:0 0 24px}
  article :global(a){color:#c83f28;text-decoration:underline;text-underline-offset:3px;overflow-wrap:anywhere}
  article :global(.details){margin:28px 0 36px;padding:24px;border-left:3px solid var(--accent);background:var(--soft)}
  article :global(.details p:last-child){margin-bottom:0}
  @media(max-width:700px){.legal{padding-top:42px;padding-bottom:80px}.back-link{margin-bottom:30px}article{border-radius:12px}article :global(h2){margin-top:40px}article :global(p),article :global(li){line-height:1.65}}
</style>
