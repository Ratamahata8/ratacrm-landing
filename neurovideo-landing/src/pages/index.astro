---
import BaseLayout from '../layouts/BaseLayout.astro'; import Header from '../components/Header.astro'; import Footer from '../components/Footer.astro'; import Media from '../components/Media.astro'; import {site,asset} from '../content/site';
const productSchema={'@context':'https://schema.org','@type':'Product',name:'NeuroVideo — пошаговый гайд по AI-видео',description:site.product.description,brand:{'@type':'Brand',name:'NeuroVideo'},offers:{'@type':'Offer',price:site.product.price.replace(/\D/g,''),priceCurrency:'RUB',url:new URL(Astro.url.pathname+'#guide',Astro.site).href}};
---
<BaseLayout><Header/><main>
<section class="hero container"><div class="hero-copy"><p class="badge"><i></i>{site.hero.badge}</p><h1>{site.hero.titleLead}<em>{site.hero.titleAccent}</em></h1><p class="lede">{site.hero.subtitle}</p><div class="actions"><a class="button" href={site.hero.primaryCta.url}>{site.hero.primaryCta.label}</a><a class="button button-ghost" href={site.hero.secondaryCta.url}>{site.hero.secondaryCta.label}</a></div></div><figure class="hero-visual"><Media poster={site.hero.poster} video={site.hero.video} alt="AI-ролик для пошагового повторения" eager controls portrait/><figcaption>Результат, который ты сможешь повторить по пошаговому разбору.</figcaption></figure></section>
<section class="benefits container" aria-label="Преимущества">{site.benefits.map(x=><article><span>{x.icon}</span><div><h3>{x.title}</h3><p>{x.text}</p></div></article>)}</section>
<section class="section container" id="works"><div class="section-intro prompt-intro"><div><p class="eyebrow">01 / БЕСПЛАТНЫЙ ПРОМТ</p><h2>Забери промт к этому видео</h2></div><div><p>Готовый промт для создания показанного выше ролика с Москвичом можно бесплатно получить в Telegram-боте.</p><p>Нажми кнопку — бот сразу отправит PDF с промтом.</p><a class="button" href="https://t.me/ratamahata_bot?start=moskvi4">Забрать промт в Telegram</a><small>Бесплатно · PDF с промтом придёт сразу в Telegram</small></div></div></section>
<section class="section process-section" id="process"><div class="container"><p class="eyebrow">02 / КАК ЭТО РАБОТАЕТ</p><div class="process">{site.process.map((step,i)=><article><div class="step-head"><span>{step.number}</span><i>↗</i></div><h3>{step.title}</h3><p>{step.text}</p>{i !== site.process.length - 1 && <b class="flow">→</b>}</article>)}</div></div></section>
<section class="product" id="guide"><div class="container product-grid"><div class="product-copy"><p class="eyebrow">03 / ГАЙД</p><h2>{site.product.title}</h2><p>{site.product.description}</p><ul>{site.product.features.map(f=><li>✓ {f}</li>)}</ul></div><article class="price-card" id="payment-placeholder"><p class="price">{site.product.price}</p><p>{site.product.accessText}</p><a class="button" href={site.product.paymentUrl} target="_blank" rel="noopener noreferrer">{site.product.buttonLabel}</a><small>{site.product.note}</small></article></div></section>
<section class="section container" id="about"><p class="eyebrow">04 / ОБ АВТОРЕ</p><div class="about"><img src={asset(site.author.image)} alt="Михаил Лопаткин — автор NeuroVideo" width="620" height="760" loading="lazy"/><div class="author-copy"><p class="role">{site.author.role}</p><h2>{site.author.name}</h2><p>{site.author.bio}</p></div></div></section>
<section class="telegram container"><span class="telegram-icon">↗</span><div><h2>{site.telegram.title}</h2><p>{site.telegram.description}</p></div><div class="actions"><a class="button button-dark" href={site.telegram.channelUrl} target="_blank" rel="noopener noreferrer">{site.telegram.channelLabel}</a><a class="button button-ghost" href={site.telegram.botUrl}>{site.telegram.botLabel}</a></div></section>
<section class="section container faq" id="faq"><div><p class="eyebrow">05 / FAQ</p><h2>Вопросы<br/>и ответы.</h2></div><div>{site.faq.map((item,i)=><details open={i===0}><summary>{item.q}<span>+</span></summary><p>{item.a}</p></details>)}</div></section>
</main><Footer/><script type="application/ld+json" set:html={JSON.stringify(productSchema)} is:inline/><script is:inline>document.querySelectorAll('video').forEach(v=>{v.addEventListener('error',()=>v.style.display='none');});</script></BaseLayout>
