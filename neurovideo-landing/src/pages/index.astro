---
import BaseLayout from '../layouts/BaseLayout.astro'; import Header from '../components/Header.astro'; import Footer from '../components/Footer.astro'; import Media from '../components/Media.astro'; import {site,asset} from '../content/site';
const productSchema={'@context':'https://schema.org','@type':'Product',name:'NeuroVideo — пошаговый гайд по AI-видео',description:site.product.description,brand:{'@type':'Brand',name:'NeuroVideo'},offers:{'@type':'Offer',price:site.product.price.replace(/\D/g,''),priceCurrency:'RUB',url:new URL(Astro.url.pathname+'#guide',Astro.site).href}};
---
<BaseLayout><Header/><main>
<section class="hero container"><div class="hero-copy"><p class="badge"><i></i>{site.hero.badge}</p><h1>{site.hero.titleLead}<em>{site.hero.titleAccent}</em></h1><p class="lede">{site.hero.subtitle}</p><div class="actions"><a class="button" href={site.hero.primaryCta.url}>{site.hero.primaryCta.label}</a><a class="button button-ghost" href={site.hero.secondaryCta.url}>{site.hero.secondaryCta.label}</a></div></div><div class="hero-visual"><Media poster={site.hero.poster} video={site.hero.video} alt="Превью процесса создания AI-видео" eager/><div class="film-strip"><span>FEATURED WORKFLOW</span><b>AI VIDEO / FROM IDEA TO SHOT</b><span>01 — 04</span></div><aside class="floating-card"><span class="circle-play">▷</span><h2>Один результат.<br/>Один понятный путь.</h2><p>Открываешь конкретный ролик и повторяешь его производство шаг за шагом.</p></aside></div></section>
<section class="benefits container" aria-label="Преимущества">{site.benefits.map(x=><article><span>{x.icon}</span><div><h3>{x.title}</h3><p>{x.text}</p></div></article>)}</section>
<section class="section container" id="works"><div class="section-intro"><div><p class="eyebrow">01 / РАБОТЫ</p><h2>{site.works.title}</h2></div><div><p>{site.works.description}</p><a class="text-link" href={site.works.link.url}>{site.works.link.label}</a></div></div><div class="works-grid">{site.works.items.map(item=><article class="work-card"><div class="work-image"><Media poster={item.poster} video={item.video} alt={item.alt}/><span class="tech">{item.badge}</span></div><h3>{item.title}</h3><div class="chips">{item.stages.map(s=><span>{s}</span>)}</div></article>)}</div></section>
<section class="section process-section" id="process"><div class="container"><p class="eyebrow">02 / КАК ЭТО РАБОТАЕТ</p><div class="process">{site.process.map((step,i)=><article><div class="step-head"><span>{step.number}</span><i>↗</i></div><h3>{step.title}</h3><p>{step.text}</p>{i !== site.process.length - 1 && <b class="flow">→</b>}</article>)}</div></div></section>
<section class="product" id="guide"><div class="container product-grid"><div class="product-copy"><p class="eyebrow">03 / ГАЙД</p><h2>{site.product.title}</h2><p>{site.product.description}</p><ul>{site.product.features.map(f=><li>✓ {f}</li>)}</ul></div><article class="price-card" id="payment-placeholder"><p class="price">{site.product.price}</p><p>{site.product.accessText}</p><a class="button" href={site.product.paymentUrl}>{site.product.buttonLabel}</a><small>{site.product.note}</small></article><img class="product-image" src={asset(site.product.visual)} alt="Рабочее пространство производства AI-видео" width="700" height="900" loading="lazy"/></div></section>
<section class="section container" id="about"><p class="eyebrow">04 / ОБ АВТОРЕ</p><div class="about"><img src={asset(site.author.image)} alt={`Портрет автора — ${site.author.name}`} width="620" height="760" loading="lazy"/><div class="author-copy"><p class="role">{site.author.role}</p><h2>{site.author.name}</h2><p>{site.author.bio}</p></div><div class="tools"><p>PRODUCTION TOOLKIT</p>{site.author.tools.map(t=><span>{t}</span>)}</div></div></section>
<section class="telegram container"><span class="telegram-icon">↗</span><div><h2>{site.telegram.title}</h2><p>{site.telegram.description}</p></div><div class="actions"><a class="button button-dark" href={site.telegram.channelUrl}>{site.telegram.channelLabel}</a><a class="button button-ghost" href={site.telegram.botUrl}>{site.telegram.botLabel}</a></div></section>
<section class="section container faq" id="faq"><div><p class="eyebrow">05 / FAQ</p><h2>Вопросы<br/>и ответы.</h2></div><div>{site.faq.map((item,i)=><details open={i===0}><summary>{item.q}<span>+</span></summary><p>{item.a}</p></details>)}</div></section>
</main><Footer/><script type="application/ld+json" set:html={JSON.stringify(productSchema)} is:inline/><script is:inline>document.querySelectorAll('video').forEach(v=>{v.addEventListener('error',()=>v.style.display='none');});</script></BaseLayout>
