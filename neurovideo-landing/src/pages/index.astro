---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Media from '../components/Media.astro';
import { site } from '../content/site';
---
<BaseLayout>
  <Header />
  <main>
    <section class="hero container">
      <div class="hero-copy">
        <p class="badge"><i></i>{site.hero.badge}</p>
        <h1>{site.hero.title}</h1>
        <p class="lede">{site.hero.subtitle}</p>
        <div class="hero-action">
          <a class="button button-main" href={site.hero.cta.url} target="_blank" rel="noopener noreferrer">{site.hero.cta.label}<span aria-hidden="true">↗</span></a>
          <p>{site.hero.note}</p>
        </div>
      </div>
      <figure class="hero-visual">
        <div class="visual-label"><span>AI VIDEO</span><span>MOSKVICH / 01</span></div>
        <Media poster={site.hero.poster} video={site.hero.video} alt="Видео с автомобилем Москвич" eager controls portrait />
      </figure>
    </section>

    <section class="product" aria-labelledby="product-title">
      <div class="container product-grid">
        <div>
          <p class="eyebrow">{site.product.eyebrow}</p>
          <h2 id="product-title">{site.product.title}</h2>
        </div>
        <div class="product-detail">
          <p>{site.product.text}</p>
          <ul>{site.product.points.map((point) => <li><span>✓</span>{point}</li>)}</ul>
          <a class="button button-light" href={site.hero.cta.url} target="_blank" rel="noopener noreferrer">{site.hero.cta.label}</a>
          <small>{site.hero.note}</small>
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <script is:inline>document.querySelectorAll('video').forEach((video) => video.addEventListener('error', () => video.style.display = 'none'));</script>
</BaseLayout>
